#!/usr/bin/env bash
# Weekly potentials. Opens dashboard.html, downloading fresh only if the data is stale.
#   ./weekly           refresh-if-stale, then open
#   ./weekly force     always re-download now, then open
#   ./weekly refresh   just re-extract the (expired) scanlink and rebuild — no re-download
set -euo pipefail
export PATH="/usr/local/bin:/opt/homebrew/bin:/Library/Frameworks/Python.framework/Versions/3.12/bin:/usr/bin:/bin"
cd "$(dirname "$0")"

URL="https://chartink.com/screener/cp-ich-trend-bounce-wkly"
SLUG="$(basename "$URL")"
META="data/${SLUG}_latest.meta.json"
DASH="dashboard.html"

FORCE=0; REFRESH=0
case "${1:-}" in
  force|--force|-f) FORCE=1 ;;
  refresh|--refresh|-r) REFRESH=1 ;;
esac

if [ "$REFRESH" = "1" ]; then
  echo "🔑 Refreshing scanlink (no re-download)…"
  python3 run.py --mode weekly --refresh --url "$URL"
  open "$DASH"
  exit 0
fi

# stale if: (a) we haven't captured the last completed week (Friday 16:00 boundary), OR
# (b) it's Friday closing hours (>=14:00) — the weekly candle is still forming, so we
# want the latest each run to plan Monday. `force` overrides both.
STALE="$(python3 - "$META" <<'PY'
import sys, json
from datetime import datetime, timedelta
now = datetime.now()
cutoff = (now - timedelta(days=(now.weekday() - 4) % 7)).replace(hour=16, minute=0, second=0, microsecond=0)
if cutoff > now:                       # today is Friday but before 16:00 -> use last Friday
    cutoff -= timedelta(days=7)
friday_pm = (now.weekday() == 4 and now.hour >= 14)   # Fri >= 2pm: refresh every run
try:
    m = json.load(open(sys.argv[1]))
    last = datetime.strptime(m["scraped_at"], "%Y-%m-%d %H:%M")
    stale = friday_pm or (last < cutoff)
except Exception:
    stale = True                       # no data yet -> must fetch
print("1" if stale else "0")
PY
)"

if [ "$FORCE" = "1" ] || [ "$STALE" = "1" ] || [ ! -f "$DASH" ]; then
  [ "$FORCE" = "1" ] && echo "↻ Force refresh…" || echo "↻ Fetching fresh data…"
  python3 run.py --mode weekly --url "$URL"
  # keep the daily page's "W" cross-tags fresh with this new weekly data (re-render, no re-scrape)
  [ -f data/history_daily.json ] && python3 daily.py --no-scrape >/dev/null 2>&1 && echo "↔ refreshed daily cross-tags" || true
else
  echo "✓ Data is current. Opening…"
fi
open "$DASH"
