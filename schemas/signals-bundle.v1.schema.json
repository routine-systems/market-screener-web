{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screener.chiragpatnaik.com/schemas/signals-bundle.v1.schema.json",
  "title": "Market signals web bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_commit",
    "generated_at_utc",
    "data_cutoff",
    "markets",
    "timeframes",
    "pages",
    "source_freshness",
    "event_gate_status",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1(?:\\.[0-9]+)*$"},
    "producer_commit": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "data_cutoff": {"type": "object"},
    "markets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "timeframes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pages": {
      "type": "object",
      "required": ["weekly", "daily", "market", "sectors", "recommendations"],
      "properties": {
        "weekly": {"$ref": "#/$defs/pageWithWindow"},
        "daily": {"$ref": "#/$defs/page"},
        "market": {"$ref": "#/$defs/page"},
        "sectors": {"$ref": "#/$defs/page"},
        "recommendations": {"$ref": "#/$defs/page"}
      }
    },
    "source_freshness": {"type": "object"},
    "event_gate_status": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["payload"],
      "properties": {"payload": {"type": "object"}}
    },
    "pageWithWindow": {
      "type": "object",
      "required": ["payload", "default_window"],
      "properties": {
        "payload": {"type": "object"},
        "default_window": {"type": "integer", "minimum": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "row_count", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "row_count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
