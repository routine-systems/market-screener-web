#!/usr/bin/env bash
# Daily market-breadth + sector-rotation: refresh if we have not pulled since the most recent
# 2pm, then open. Builds BOTH market.html and sectors.html (the 4th page: cp-cmo-wkly mapped
# to Downloads/data.csv sectors). Open sectors.html from the top nav.
#   ./market            refresh-if-stale, then open market.html
#   ./market force      always refresh now, then open
set -euo pipefail
export PATH="/usr/local/bin:/opt/homebrew/bin:/Library/Frameworks/Python.framework/Versions/3.12/bin:/usr/bin:/bin"
cd "$(dirname "$0")"

STORE="data/market_counts.json"
FORCE=0
case "${1:-}" in force|--force|-f) FORCE=1 ;; esac

# stale if the store has not been updated since the most recent 2pm cutoff
STALE="$(python3 - "$STORE" <<'PY'
import sys, json
from datetime import datetime, timedelta
now = datetime.now()
cutoff = now.replace(hour=14, minute=0, second=0, microsecond=0)
if cutoff > now:                       # before 2pm -> use the previous day 2pm
    cutoff -= timedelta(days=1)
try:
    m = json.load(open(sys.argv[1]))
    stale = datetime.strptime(m["updated_at"], "%Y-%m-%d %H:%M") < cutoff
except Exception:
    stale = True
print("1" if stale else "0")
PY
)"

if [ "$FORCE" = "1" ] || [ "$STALE" = "1" ] || [ ! -f market.html ] || [ ! -f sectors.html ]; then
  echo "↻ Fetching market breadth + sector rotation (10 screeners, pausing between)…"
  python3 market.py
  # refresh the weekly/daily rotation dots with the just-updated sector data (re-render, no scrape)
  [ -f data/history.json ] && python3 build_dashboard.py >/dev/null 2>&1 && echo "↔ refreshed weekly rotation" || true
  [ -f data/history_daily.json ] && python3 daily.py --no-scrape >/dev/null 2>&1 && echo "↔ refreshed daily rotation" || true
else
  echo "✓ Market data current (since the last 2pm). Opening…"
fi
open market.html
